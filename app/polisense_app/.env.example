# Copy this file to .env and fill in your real values.
# Never commit the real .env file.

# ── Database (Postgres + pgvector) ───────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=polisense_db_dev
PG_USER=postgres
PG_PASSWORD=
# Use "require" for managed/cloud Postgres (RDS, Supabase, Neon, etc.)
PG_SSLMODE=prefer

DB_POOL_MIN_CONN=1
DB_POOL_MAX_CONN=10

# ── Embedding model (local, via sentence-transformers) ───────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Retrieval defaults (overridable per-search in the sidebar) ──────────────
TOP_K=30
FINAL_N=5
MMR_LAMBDA=0.6

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
LOG_TO_CONSOLE=true

# ── App ──────────────────────────────────────────────────────────────────────
APP_TITLE=PoliSense — Policy Discovery
