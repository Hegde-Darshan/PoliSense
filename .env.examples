# Environment variables for PoliSense application
# Model cache directories
SENTENCE_TRANSFORMERS_HOME=<path>
TRANSFORMERS_CACHE=<path>
HF_DATASETS_CACHE=<path>
HF_METRICS_CACHE=<path>
HF_HOME=<path>

#Embedding model
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

#Postgres settings
POSTGRES_HOST=<hostname>
POSTGRES_PORT=<port number>
POSTGRES_DB=<db_name>
POSTGRES_CONTAINER_NAME=<container_name>
POSTGRES_USER=<username>
POSTGRES_PASSWORD=<password>

#Docker settings
COMPOSE_PROJECT_NAME = <project_name>

#Zoho OAuth2 self-client credentials (for zoho_poller.py)
ZOHO_DC=in                           # data-centre: in | com | eu | au
ZOHO_CLIENT_ID=<client_id>
ZOHO_CLIENT_SECRET=<client_secret>
ZOHO_REFRESH_TOKEN=<refresh_token>
ZOHO_WORKBOOK_ID=<workbook_id>       # alphanumeric ID from the sheet URL
ZOHO_SHEET_NAME=Entries              # worksheet tab name