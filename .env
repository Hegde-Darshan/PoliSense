# Environment variables for PoliSense application

# Model cache directories
SENTENCE_TRANSFORMERS_HOME=./models/sentence_transformers
TRANSFORMERS_CACHE=./models/transformers
HF_DATASETS_CACHE=./models/hf_datasets
HF_METRICS_CACHE=./models/hf_metrics
HF_HOME=./models/hf_home

#Embedding model
EMBEDDING_MODEL="BAAI/bge-small-en-v1.5"

#Postgres settings
POSTGRES_USER=polisense_user
POSTGRES_PASSWORD=polisense_password
POSTGRES_DB=polisense_db_dev
POSTGRES_CONTAINER_NAME=polisense_postgres
POSTGRES_PORT=5432

#Docker settings
COMPOSE_PROJECT_NAME = polisense

#langsmith variables
LANGSMITH_TRACING= "true"
LANGSMITH_ENDPOINT= "https://api.smith.langchain.com"