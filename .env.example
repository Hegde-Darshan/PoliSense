# HuggingFace model cache directories (optional — controls where models are downloaded)
# Remove or adjust these if you want models stored at HuggingFace defaults (~/.cache/huggingface)
SENTENCE_TRANSFORMERS_HOME=./models/sentence_transformers
HF_HOME=./models/hf_home

# Postgres connection (non-sensitive)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=polisense_db_dev

# Zoho — non-sensitive settings
# ZOHO_DC: data-centre code — in | com | eu | au
ZOHO_DC=in
ZOHO_SHEET_NAME=Entries

# Optional: absolute path to project data root (defaults to cwd if unset)
# RAG_BASE_DIR=/absolute/path/to/project
