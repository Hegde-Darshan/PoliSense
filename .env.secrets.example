# Google Gemini API key — read as GOOGLE_API_KEY by langchain_google_genai
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Postgres credentials
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password

# LangSmith tracing — set LANGSMITH_PROJECT to match your LangSmith project name
# Get API key from: https://smith.langchain.com/settings
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=PoliSense

# Zoho Sheets OAuth2 credentials (self-client flow)
# Create at: https://api-console.zoho.in → Self Client → generate refresh token with ZohoSheet.dataAPI.READ scope
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
# Workbook ID: alphanumeric ID from the Zoho Sheet URL
ZOHO_WORKBOOK_ID=your_zoho_workbook_id
